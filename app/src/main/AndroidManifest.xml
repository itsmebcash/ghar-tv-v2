<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One APK for Android TV (remote) and phones/tablets (touch) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      Shared with Ghar Launcher. "signature" = only apps signed with the same key get it.
      Both apps declare it, so they can be installed in any order.
    -->
    <permission
        android:name="com.ghar.tv.permission.CHANNELS"
        android:description="@string/permission_description"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.ghar.tv.permission.CHANNELS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To tell "offline" from "channel broken", so channels aren't skipped while offline -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Many free IPTV streams are plain http://, so cleartext must be allowed -->
    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false" />

        <!-- Read-only favourites / last-watched for Ghar Launcher (no stream addresses) -->
        <provider
            android:name=".ChannelsProvider"
            android:authorities="com.ghar.tv.channels"
            android:exported="true"
            android:readPermission="com.ghar.tv.permission.CHANNELS"
            android:writePermission="com.ghar.tv.permission.NO_WRITES" />

        <!-- "Play this channel" / "Resume" from Ghar Launcher -->
        <activity
            android:name=".OpenChannelActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="com.ghar.tv.permission.CHANNELS"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.ghar.tv.action.PLAY_CHANNEL" />
                <action android:name="com.ghar.tv.action.RESUME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Get from phone": favourites and playlists from Ghar TV Mobile over Wi-Fi -->
        <activity
            android:name=".ReceiveActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Ghar Launcher's screensaver: favourite channels, muted, one after another -->
        <activity
            android:name=".ScreensaverActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:permission="com.ghar.tv.permission.CHANNELS"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="com.ghar.tv.action.SCREENSAVER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
