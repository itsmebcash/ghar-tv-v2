<?xml version="1.0" encoding="utf-8"?>
<!-- Start screen choice: frosted like the channel cards; white when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="24dp" /><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><corners android:radius="24dp" /><solid android:color="#E6FFFFFF" /></shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
