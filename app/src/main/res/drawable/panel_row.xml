<?xml version="1.0" encoding="utf-8"?>
<!-- The channel playing now: a red bar on the left and a faint red wash -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item><shape><corners android:radius="10dp" /><solid android:color="#26E50914" /></shape></item>
            <item android:gravity="start|center_vertical" android:width="4dp" android:height="30dp" android:left="2dp">
                <shape><corners android:radius="2dp" /><solid android:color="#FFE50914" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
