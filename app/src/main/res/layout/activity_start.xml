<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_title"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/start_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/start_question"
        android:textColor="#B3FFFFFF"
        android:textSize="@dimen/start_question" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/start_tv"
            android:layout_width="@dimen/start_card_w"
            android:layout_height="@dimen/start_card_h"
            android:background="@drawable/start_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@+id/start_music"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺"
                android:textSize="@dimen/start_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/start_tv"
                android:textColor="@color/start_title"
                android:textSize="@dimen/start_card_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="@string/start_tv_sub"
                android:textColor="@color/start_sub"
                android:textSize="@dimen/start_card_sub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/start_music"
            android:layout_width="@dimen/start_card_w"
            android:layout_height="@dimen/start_card_h"
            android:layout_marginStart="40dp"
            android:background="@drawable/start_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/start_tv"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="@dimen/start_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/start_music"
                android:textColor="@color/start_title"
                android:textSize="@dimen/start_card_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="@string/start_music_sub"
                android:textColor="@color/start_sub"
                android:textSize="@dimen/start_card_sub" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/start_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="#FFFFC27A"
        android:textSize="@dimen/start_card_sub"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/credit"
        android:textColor="#66FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
