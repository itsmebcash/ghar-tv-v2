<?xml version="1.0" encoding="utf-8"?>
<!--
  One layout, two arrangements (switched in code, so rotating never restarts the stream):
  - TV / phone sideways: video fills the screen; overlays = star (top), control bar (bottom), channel panel.
  - Phone upright: YouTube-style "watch page" - video on top, then channel info, categories, channel list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/video_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />

        <!-- Connecting / Buffering / Reconnecting / No internet -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="58dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Volume / brightness level while swiping on the right / left edge -->
        <LinearLayout
            android:id="@+id/level_box"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/message_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/level_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/level_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="#FFC27A" />
        </LinearLayout>

        <!-- Short notices: skipped channel, screen mode, favourite added -->
        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/message_bg"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- TOP: favourite -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/top_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/info_side"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/info_side"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fav_button"
                style="@style/PillButton"
                android:text="@string/fav_add" />

            <TextView
                android:id="@+id/fav_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:text="@string/fav_hint_tv"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- BOTTOM: channel name, programme, clock and controls together -->
        <LinearLayout
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/info_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/info_side"
            android:paddingTop="48dp"
            android:paddingEnd="@dimen/info_side"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:minWidth="52dp"
                android:textColor="#FFFFFF"
                android:textSize="40sp" />

            <ImageView
                android:id="@+id/channel_logo"
                android:layout_width="@dimen/info_logo_w"
                android:layout_height="@dimen/info_logo_h"
                android:layout_marginStart="12dp"
                android:background="@drawable/logo_bg"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/info_texts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/channel_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/channel_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Phone only: same bar as the channel name -->
            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channels_button"
                    style="@style/PillButton"
                    android:text="@string/channels" />

                <TextView
                    android:id="@+id/cc_button"
                    style="@style/PillButton"
                    android:layout_marginStart="8dp"
                    android:minWidth="48dp"
                    android:text="@string/subtitles" />

                <TextView
                    android:id="@+id/mode_button"
                    style="@style/PillButton"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/rotate_button"
                    style="@style/PillButton"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 12-hour clock -->
            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Channel panel over the video: categories + channels -->
        <FrameLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <View
                android:id="@+id/panel_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#4D000000"
                android:clickable="true"
                android:focusable="false" />

            <LinearLayout
                android:id="@+id/panel_box"
                android:layout_width="@dimen/panel_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#F20A0C14"
                android:clickable="true"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="22dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-light"
                        android:text="@string/channels"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/browse_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="@string/browse_all"
                        android:textColor="@color/category_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/panel_hint"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ScrollView
                        android:layout_width="@dimen/panel_categories_width"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="20dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/panel_categories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <ListView
                        android:id="@+id/panel_list"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:drawSelectorOnTop="false"
                        android:listSelector="@drawable/panel_selector"
                        android:paddingBottom="20dp"
                        android:scrollbars="none" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Phone upright only: the watch page below the video -->
    <LinearLayout
        android:id="@+id/below"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B0D16"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/below_logo"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:background="@drawable/logo_bg"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/below_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/below_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/below_fav"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/round_touch"
                android:clickable="true"
                android:contentDescription="@string/favourite"
                android:gravity="center"
                android:text="@string/star_empty"
                android:textColor="#FFC27A"
                android:textSize="24sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/below_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ListView
            android:id="@+id/below_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
    </LinearLayout>
</LinearLayout>
